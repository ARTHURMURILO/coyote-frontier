<controls:FancyWindow xmlns="https://spacestation14.io"
                       xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                       Title="AI Core"
                       MinSize="400 180"
                       SetSize="740 220">
    <ScrollContainer Name="FullView" HorizontalExpand="True" VerticalExpand="True" Visible="True">
        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
            <BoxContainer Name="OwnerSection" Orientation="Vertical" SeparationOverride="4">
                <Label Name="OwnerLabel" Text="Unclaimed" FontColorOverride="#FFA500" />
                <Label Name="LockStatusLabel" Text="Status: Unlocked" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Button Name="LockButton" Text="Lock" MinSize="100 30" Disabled="True" />
                    <Button Name="AbandonButton" Text="Abandon" MinSize="120 30" Disabled="True" />
                    <Button Name="EnabledButton" ToggleMode="True" Text="Enabled" MinSize="120 36" />
                    <Button Name="ResetHistoryButton" Text="Reset History" MinSize="140 30" />
                </BoxContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Label Text="AI Name" />
            <LineEdit Name="AiNameEdit" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Personality" />
            <LineEdit Name="PersonalityEdit" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Law Set" />
            <OptionButton Name="LawSetDropdown" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Max History (5-1000)" />
            <LineEdit Name="MaxHistoryEdit" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Max Tokens" />
            <LineEdit Name="MaxTokensEdit" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Vision Range (1-15m)" />
            <LineEdit Name="VisionRangeEdit" MinSize="80 30" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Label Text="API Endpoint" />
            <LineEdit Name="ApiEndpointEdit" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Model Name (optional)" />
            <LineEdit Name="ModelNameEdit" HorizontalExpand="True" MinSize="0 30" />

            <Label Text="Temperature (0.1 - 2.0)" />
            <LineEdit Name="TemperatureEdit" MinSize="80 30" />

            <Label Text="API Key" />
            <LineEdit Name="ApiKeyEdit" HorizontalExpand="True" MinSize="0 30" />
            <Label Name="ApiKeyStatus" Text="" FontColorOverride="#888888" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Label Text="Reasoning Level" />
            <OptionButton Name="ReasoningDropdown" HorizontalExpand="True" MinSize="0 30" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Button Name="VisionToggle" Text="▼ VISION" MinSize="0 30" Margin="0 4" />
            <BoxContainer Name="VisionSection" Orientation="Vertical" SeparationOverride="4" Visible="True">

                <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                <Label Text="▼ LOCAL" FontColorOverride="#FFA500" />
                <BoxContainer Name="LocalVisionSection" Orientation="Vertical" SeparationOverride="4" Margin="8 0 0 0">

                    <Label Text="── CREW/MOBS ──" FontColorOverride="#888888" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="VisionPeopleLocalCheck" Text="Show People" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                    <Label Text="── MACHINES/COMPUTERS ──" FontColorOverride="#888888" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="VisionMachinesLocalCheck" Text="Show Machines" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="16 0 0 0">
                        <CheckBox Name="VisionMachinesDetailLocalCheck" Text="Details (description, powered, distance, direction)" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                    <Label Text="── ITEMS ──" FontColorOverride="#888888" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="16 0 0 0">
                        <Label Text="Item mode:" MinSize="80 30" VerticalAlignment="Center" />
                        <OptionButton Name="LocalItemModeDropdown" MinSize="140 30" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="VisionItemsLocalCheck" Text="Show Items" />
                    </BoxContainer>
                    <BoxContainer Name="LocalItemDetailCheckContainer" Orientation="Horizontal" SeparationOverride="8" Margin="16 0 0 0">
                        <CheckBox Name="VisionItemsDetailLocalCheck" Text="Details (description, legality, amount, direction)" />
                    </BoxContainer>

                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                <Label Text="▼ GLOBAL (CAMERAS)" FontColorOverride="#FFA500" />
                <BoxContainer Name="GlobalVisionSection" Orientation="Vertical" SeparationOverride="4" Margin="8 0 0 0">

                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="GlobalVisionEnabledCheck" Text="Enable Camera Vision (Master Switch)" />
                    </BoxContainer>

                    <BoxContainer Name="GlobalCameraSubnetContainer" Orientation="Vertical" SeparationOverride="2" Margin="16 0 0 0" />

                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                    <Label Text="── PEOPLE ──" FontColorOverride="#888888" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="VisionPeopleGlobalCheck" Text="Show People" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                    <Label Text="── MACHINES/COMPUTERS ──" FontColorOverride="#888888" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="VisionMachinesGlobalCheck" Text="Show Machines" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="16 0 0 0">
                        <CheckBox Name="VisionMachinesDetailGlobalCheck" Text="Show machine names" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                    <Label Text="── ITEMS ──" FontColorOverride="#888888" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="16 0 0 0">
                        <Label Text="Item mode:" MinSize="80 30" VerticalAlignment="Center" />
                        <OptionButton Name="GlobalItemModeDropdown" MinSize="140 30" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <CheckBox Name="VisionItemsGlobalCheck" Text="Show Items" />
                    </BoxContainer>
                    <BoxContainer Name="GlobalItemDetailCheckContainer" Orientation="Horizontal" SeparationOverride="8" Margin="16 0 0 0">
                        <CheckBox Name="VisionItemsDetailGlobalCheck" Text="Details" />
                    </BoxContainer>

                </BoxContainer>
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Button Name="RadioToggle" Text="▼ RADIO" MinSize="0 30" Margin="0 4" />
            <BoxContainer Name="RadioSection" Orientation="Vertical" SeparationOverride="4" Visible="True">
                <BoxContainer Name="RadioChannelContainer" Orientation="Vertical" SeparationOverride="2" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Label Name="HistoryLabel" Text="" FontColorOverride="#888888" />
            <Label Name="TokenLabel" Text="" FontColorOverride="#888888" />
            <Label Name="TotalTokenLabel" Text="" FontColorOverride="#888888" />

            <BoxContainer Name="TokenBarContainer" Orientation="Horizontal" MinSize="0 20" Margin="0 2" />
            <BoxContainer Name="TokenLegendContainer" Orientation="Vertical" MinSize="0 16" Margin="0 0 0 4" SeparationOverride="2" />

            <!-- Ship awareness display -->
            <Label Name="ShipLabel" Text="" FontColorOverride="#888888" />

            <!-- Load tracking display -->
            <Label Name="LoadLabel" Text="" FontColorOverride="#888888" />

            <!-- Advanced Settings toggle -->
            <Button Name="AdvancedToggle" Text="▼ Advanced Settings" MinSize="0 30" Margin="0 4" />

            <BoxContainer Name="AdvancedSection" Orientation="Vertical" SeparationOverride="4" Visible="False">
                <Label Text="Response Cooldown" FontColorOverride="#888888" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="Base (s)" MinSize="60 0" VerticalAlignment="Center" />
                    <LineEdit Name="CooldownBaseEdit" MinSize="80 30" />
                    <Button Name="CooldownBaseDefault" Text="Default" MinSize="70 30" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="Char Factor" MinSize="60 0" VerticalAlignment="Center" />
                    <LineEdit Name="CooldownCharFactorEdit" MinSize="80 30" />
                    <Button Name="CooldownCharFactorDefault" Text="Default" MinSize="70 30" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="Max (s)" MinSize="60 0" VerticalAlignment="Center" />
                    <LineEdit Name="CooldownMaxEdit" MinSize="80 30" />
                    <Button Name="CooldownMaxDefault" Text="Default" MinSize="70 30" />
                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                <Label Text="Forced Auto-Continue" FontColorOverride="#888888" />
                <CheckBox Name="AutoContinueCheck" Text="Enable forced auto-continue" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="Threshold" MinSize="60 0" VerticalAlignment="Center" />
                    <LineEdit Name="AutoContinueThresholdEdit" MinSize="80 30" />
                    <Button Name="AutoContinueThresholdDefault" Text="Default" MinSize="70 30" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="Max Continues" MinSize="60 0" VerticalAlignment="Center" />
                    <LineEdit Name="AutoContinueMaxEdit" MinSize="80 30" />
                    <Button Name="AutoContinueMaxDefault" Text="Default" MinSize="70 30" />
                </BoxContainer>

                <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

                <Label Text="LLM Request Timeout" FontColorOverride="#888888" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Label Text="Seconds" MinSize="60 0" VerticalAlignment="Center" />
                    <LineEdit Name="RequestTimeoutEdit" MinSize="80 30" />
                    <Button Name="RequestTimeoutDefault" Text="Default" MinSize="70 30" />
                </BoxContainer>

            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Button Name="ExportButton" Text="Export AI" MinSize="120 36" />
                <Button Name="ImportButton" Text="Import AI" MinSize="120 36" />
            </BoxContainer>

            <Button Name="SaveButton" Text="Save Configuration" MinSize="0 44" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Label Text="MEMORIES" StyleClasses="LabelHeading" />
            <BoxContainer Name="MemoriesContainer" Orientation="Vertical" SeparationOverride="4" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 4">
                <OptionButton Name="MemoryPriorityDropdown" MinSize="100 30" />
                <LineEdit Name="NewMemoryEdit" PlaceHolder="New memory content..." HorizontalExpand="True" MinSize="0 30" />
                <Button Name="AddMemoryButton" Text="Add" MinSize="60 30" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

            <Button Name="LogicChannelsToggle" Text="▶ LOGIC CHANNELS" MinSize="0 30" Margin="0 4" />
            <BoxContainer Name="LogicChannelsSection" Orientation="Vertical" SeparationOverride="4" Visible="False">
                <BoxContainer Name="LogicChannelContainer" Orientation="Vertical" SeparationOverride="4" />
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>

    <BoxContainer Name="LockedView" Orientation="Vertical" Margin="10" SeparationOverride="4"
                  VerticalExpand="True" HorizontalExpand="True" Visible="False">
        <Label Name="LockedOwnerLabel" Text="Registered to:" FontColorOverride="#00FF00" />
        <Label Name="LockedStatusLabel" Text="Status: Locked" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 8 0 0">
            <Button Name="LockedLockButton" Text="Unlock" MinSize="100 30" />
            <Button Name="LockedAbandonButton" Text="Abandon" MinSize="120 30" Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
